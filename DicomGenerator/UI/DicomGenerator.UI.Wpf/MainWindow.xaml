<mah:MetroWindow
    x:Class="DicomGenerator.UI.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:DicomGenerator.Core;assembly=DicomGenerator.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:DicomGenerator.UI.Wpf.ViewModels"
    xmlns:views="clr-namespace:DicomGenerator.UI.Wpf.Views"
    xmlns:wpf="clr-namespace:DicomGenerator.UI.Wpf"
    Title="Generator Dicom File"
    Width="905"
    Height="555"
    Icon="D:\Develop\dicomGenerator\DicomGenerator\UI\DicomGenerator.UI.Wpf\DicomGenerator.ico"
    WindowStartupLocation="CenterScreen"
    WindowStyle="ThreeDBorderWindow"
    mc:Ignorable="d">



    <!--  Path for install         Icon="C:\Program Files (x86)\DicomGenerator\DicomGeneratorTestData\Resources\DicomGenerator.ico"  -->

    <!--  Path for debug           Icon="D:\Develop\dicomGenerator\DicomGenerator\UI\DicomGenerator.UI.Wpf\DicomGenerator.ico"  -->

    <TabControl>

        <TabControl.Resources>
            <Style TargetType="TabItem">
                <Setter Property="Padding" Value="3" />
                <Setter Property="Margin" Value="4,1,1,1" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    ContentSource="Header" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Accent}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate DataType="{x:Type viewmodels:FileGeneratorViewModel}">
                <views:FileGeneratorUserControl />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:FileSenderViewModel}">
                <views:FileSenderUserControl />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:DicomFileParserViewModel}">
                <views:DicomFileParserUserControl />
            </DataTemplate>
        </TabControl.Resources>


        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="3"
                        FontSize="16"
                        Text="📁" />
                    <TextBlock
                        Margin="0,3,10,3"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Generate" />
                </StackPanel>
            </TabItem.Header>

            <views:FileGeneratorUserControl />
        </TabItem>

        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="3"
                        FontSize="16"
                        Text="🌐" />
                    <TextBlock
                        Margin="0,3,10,3"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="PACS" />
                </StackPanel>
            </TabItem.Header>

            <views:FileSenderUserControl />
        </TabItem>

        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="3"
                        FontSize="16"
                        Text="📄" />
                    <TextBlock
                        Margin="0,3,10,3"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="Парсинг DICOM" />
                </StackPanel>
            </TabItem.Header>

            <views:DicomFileParserUserControl />
        </TabItem>

    </TabControl>

</mah:MetroWindow>