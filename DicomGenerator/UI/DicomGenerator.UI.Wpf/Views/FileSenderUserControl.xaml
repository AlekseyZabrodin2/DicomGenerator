<UserControl
    x:Class="DicomGenerator.UI.Wpf.Views.FileSenderUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:DicomGenerator.UI.Wpf.Views"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:DicomGenerator.UI.Wpf.ViewModels"
    d:DataContext="{d:DesignInstance viewmodels:FileSenderViewModel}"
    mc:Ignorable="d">


    <Border
        Grid.Row="0"
        BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
        BorderThickness="4">

        <Grid
            Width="500"
            VerticalAlignment="Center"
            ShowGridLines="True">

            <StackPanel>

                <Grid x:Name="ConnectingBlock" Margin="5,0,5,0">

                    <Border BorderBrush="{DynamicResource MahApps.Brushes.Accent}" BorderThickness="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <StackPanel>
                                    <TextBlock
                                        Margin="5,5,0,0"
                                        FontWeight="DemiBold"
                                        Text="Клиент - AE Title:" />
                                    <TextBox Margin="5" Text="{Binding CallingAe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Column="1">
                                <StackPanel>
                                    <TextBlock
                                        Margin="5,5,0,0"
                                        FontWeight="DemiBold"
                                        Text="Сервер IP:" />
                                    <TextBox Margin="5" Text="{Binding ServerIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock
                                        Margin="5,5,0,0"
                                        FontWeight="DemiBold"
                                        Text="Сервер Port:" />
                                    <TextBox Margin="5" Text="{Binding ServerPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock
                                        Margin="5,0,0,0"
                                        FontWeight="DemiBold"
                                        Text="Сервер - AE Title:" />
                                    <TextBox Margin="5" Text="{Binding CalledAe, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <Grid
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Margin="5,0,0,0"
                                        FontWeight="DemiBold"
                                        Text="Путь к файлам:" />
                                    <TextBox
                                        Grid.Row="1"
                                        Margin="5,3,0,5"
                                        Text="{Binding FolderPathShort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="{Binding FolderPathFull}" />
                                </Grid>

                                <Button
                                    Grid.Column="1"
                                    Width="25"
                                    Height="25"
                                    Margin="5"
                                    Padding="1,0,1,4"
                                    VerticalAlignment="Bottom"
                                    HorizontalContentAlignment="Center"
                                    Background="{DynamicResource MahApps.Brushes.Accent}"
                                    Command="{Binding BrowseDatabaseCommand}"
                                    Content="📁"
                                    FontSize="15"
                                    ToolTip="Выбрать файл базы данных" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Border
                    x:Name="OutputText"
                    Margin="5"
                    BorderBrush="{DynamicResource MahApps.Brushes.Accent}"
                    BorderThickness="4">

                    <TextBox
                        MinHeight="40"
                        HorizontalAlignment="Center"
                        VerticalContentAlignment="Center"
                        BorderThickness="0"
                        FontSize="12"
                        IsReadOnly="True"
                        Text="{Binding ServerOutputText, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                </Border>

                <Grid x:Name="ButtonsBlock">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button
                        Width="70"
                        Height="40"
                        Margin="10"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource MahApps.Brushes.Accent}"
                        Command="{Binding CancaelSendingImageCommand}"
                        Content="Cancel" />

                    <Button
                        Grid.Column="1"
                        Width="70"
                        Height="40"
                        Margin="10"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource MahApps.Brushes.Accent}"
                        Command="{Binding SendDicomImageCommand}"
                        Content="Move File" />
                </Grid>

            </StackPanel>

            <Grid
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Visibility="{Binding IsVisible}">

                <Border Background="White" Opacity=".7">


                    <mah:ProgressRing
                        Width="100"
                        Height="100"
                        Foreground="{DynamicResource MahApps.Brushes.AccentBase}" />

                </Border>
            </Grid>
        </Grid>
    </Border>

</UserControl>
